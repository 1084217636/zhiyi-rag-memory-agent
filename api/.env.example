# ============ 应用 ============
APP_NAME=Zhiyi AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# 前端地址，用于 CORS
CORS_ORIGINS=http://localhost:5173

# ============ 安全 ============
# JWT 签名密钥，生产请改成随机长字符串
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# API Key 对称加密密钥（Fernet，44 位 base64），生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key

# ============ PostgreSQL ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=zhiyi
POSTGRES_PASSWORD=zhiyi
POSTGRES_DB=zhiyi
# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=60000

# ============ Elasticsearch ============
ES_HOST=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_MAX_RETRIES=3
ES_REQUEST_TIMEOUT=30
ES_MAX_CONNECTIONS=25

# ============ Neo4j ============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=zhiyineo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# ============ Redis / Celery ============
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============ 文件存储 ============
# 存储后端：local（本地目录）/ oss（阿里云对象存储）
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# 阿里云 OSS 配置（STORAGE_BACKEND=oss 时填写）
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=zhiyi-files

# ============ 日志 ============
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/zhiyi.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DB_ECHO=false

# ============ 知识库 RAG ============
EMBEDDING_DIMS=1024
# 以下是兼容现有数据的默认值；调整权重先运行离线评测，调整分块后要重建索引
RAG_FUSION_METHOD=rrf
RAG_VECTOR_WEIGHT=0.6
RAG_QUERY_EMBEDDING_CACHE_TTL_SECONDS=300
RAG_RRF_K=60
RAG_PARENT_CHUNK_TOKENS=1024
RAG_CHILD_CHUNK_TOKENS=256
RAG_CHILD_OVERLAP_TOKENS=24

# ============ Agent 执行边界（初始策略，需按负载和模型成本调整） ============
MEMORY_ACTIVE_LIMIT=1000
MEMORY_GRAPH_NODE_LIMIT=10000
MEMORY_CANDIDATE_LIMIT=8
AGENT_INPUT_TOKEN_BUDGET=12000
AGENT_OUTPUT_TOKEN_BUDGET=1024
AGENT_MAX_TOOL_CALLS=8
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_TOOL_ARGUMENT_MAX_CHARS=6000
AGENT_TOOL_OUTPUT_MAX_CHARS=24000
AGENT_REQUESTS_PER_MINUTE=12
AGENT_MAX_CONCURRENT_RUNS_PER_USER=2
AGENT_MAX_CONCURRENT_RUNS_GLOBAL=32
# 外部工具默认不进入问答；开放前逐个审查读写权限和网络出口
AGENT_EXTERNAL_TOOLS_ENABLED=false
AGENT_EXTERNAL_TOOL_ALLOWLIST=
